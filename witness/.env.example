# https://supabase.com/dashboard — Project Settings → API / General
# Copy this file to .env.local and fill in real values (never commit .env.local).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Use either the legacy anon "public" key or the new publishable key (sb_publishable_...):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Or instead of NEXT_PUBLIC_SUPABASE_ANON_KEY:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# After creating the project, set Authentication → URL Configuration:
# - Site URL: http://localhost:3000 (dev) or https://your-production-domain
# - Redirect URLs: add http://localhost:3000/auth/confirm and your production /auth/confirm
#
# Optional: Authentication → Providers → Email → disable "Confirm email"
# for faster local testing (users get a session immediately on sign up).
