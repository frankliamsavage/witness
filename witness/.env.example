# https://supabase.com/dashboard — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# After creating the project, set Authentication → URL Configuration:
# - Site URL: http://localhost:3000 (dev) or https://your-production-domain
# - Redirect URLs: add http://localhost:3000/auth/confirm and your production /auth/confirm
#
# Optional: Authentication → Providers → Email → disable "Confirm email"
# for faster local testing (users get a session immediately on sign up).
